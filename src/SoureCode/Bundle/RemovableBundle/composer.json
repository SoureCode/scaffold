{
    "name": "sourecode/removable-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integration for sourecode/removable.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.2",
        "sourecode/authorable-bundle": "self.version",
        "sourecode/removable": "self.version",
        "sourecode/timestampable-bundle": "self.version",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Bundle\\RemovableBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Bundle\\RemovableBundle\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.1",
        "phpunit/phpunit": "^13.1"
    }
}
