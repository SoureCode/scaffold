{
    "name": "sourecode/timestampable-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integration for sourecode/timestampable.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "sourecode/timestampable": "self.version",
        "symfony/framework-bundle": "^8.0",
        "doctrine/doctrine-bundle": "^3.2",
        "symfony/clock": "^8.0",
        "sourecode/doctrine-extensions-bundle": "self.version"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Bundle\\TimestampableBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Bundle\\TimestampableBundle\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.1",
        "phpunit/phpunit": "^13.1"
    }
}
