{
    "name": "sourecode/traceable-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integration for sourecode/traceable (HTTP, CLI, Messenger).",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "psr/log": "^3.0",
        "sourecode/traceable": "self.version",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/uid": "^8.0"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Bundle\\TraceableBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Bundle\\TraceableBundle\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.1",
        "phpunit/phpunit": "^13.1"
    }
}
