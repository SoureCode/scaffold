{
    "name": "sourecode/authorable-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integration for sourecode/authorable.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "sourecode/authorable": "self.version",
        "symfony/framework-bundle": "^8.0",
        "doctrine/doctrine-bundle": "^3.2",
        "sourecode/doctrine-extensions-bundle": "self.version",
        "symfony/security-core": "^8.0"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Bundle\\AuthorableBundle\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Bundle\\AuthorableBundle\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.1",
        "phpunit/phpunit": "^13.1",
        "symfony/security-bundle": "^8.0"
    },
    "suggest": {
        "symfony/security-bundle": "Enables the bundled SecurityAuthorProvider (uses Security::getUser()) as the default author source."
    }
}
