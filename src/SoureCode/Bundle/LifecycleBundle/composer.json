{
    "name": "sourecode/lifecycle-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle integration for sourecode/lifecycle: Authorable, Timestampable, and Removable behaviors.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.2",
        "sourecode/doctrine-extensions-bundle": "self.version",
        "sourecode/lifecycle": "self.version",
        "symfony/clock": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/security-bundle": "^8.0"
    },
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.1",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "SoureCode\\Bundle\\LifecycleBundle\\": ""
        },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {
            "SoureCode\\Bundle\\LifecycleBundle\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable"
}
