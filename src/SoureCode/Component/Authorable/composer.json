{
    "name": "sourecode/authorable",
    "type": "library",
    "description": "Automatic created-by/updated-by tracking for Doctrine entities.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/orm": "^3.6",
        "sourecode/doctrine-extensions": "self.version",
        "sourecode/removable": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Component\\Authorable\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Component\\Authorable\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable"
}
