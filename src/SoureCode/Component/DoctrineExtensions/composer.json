{
    "name": "sourecode/doctrine-extensions",
    "type": "library",
    "description": "Shared building blocks for SoureCode Doctrine behaviors.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Component\\DoctrineExtensions\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Component\\DoctrineExtensions\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable"
}
