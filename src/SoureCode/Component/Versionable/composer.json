{
    "name": "sourecode/versionable",
    "type": "library",
    "description": "Per-entity snapshot history for Doctrine entities.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/orm": "^3.6",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "symfony/cache": "^8.0",
        "symfony/clock": "^8.0"
    },
    "autoload": {
        "psr-4": { "SoureCode\\Component\\Versionable\\": "" },
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": { "SoureCode\\Component\\Versionable\\Tests\\": "Tests/" }
    },
    "minimum-stability": "stable"
}
