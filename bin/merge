#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$rootFile = $root . '/composer.json';
$srcRoot = $root . '/src';
$checkOnly = in_array('--check', array_slice($argv, 1), true);

if (!is_file($rootFile)) {
    fwrite(STDERR, "missing root composer.json: {$rootFile}\n");
    exit(1);
}

$rootJson = json_decode((string) file_get_contents($rootFile), true, flags: JSON_THROW_ON_ERROR);

if (!isset($rootJson['require']['php'])) {
    fwrite(STDERR, "root composer.json must declare a require.php constraint (single source of truth for the PHP baseline)\n");
    exit(1);
}

$rootPhp = $rootJson['require']['php'];

// Walk src/ recursively for any composer.json so a new package nested at a
// different depth is picked up automatically instead of silently dropped.
$packageFiles = [];

if (is_dir($srcRoot)) {
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($srcRoot, FilesystemIterator::SKIP_DOTS),
    );

    foreach ($iterator as $fileInfo) {
        if ($fileInfo->getFilename() !== 'composer.json') {
            continue;
        }

        // Anything under a vendor/ tree belongs to a sub-install — skip it.
        if (str_contains((string) $fileInfo->getPath(), DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR)) {
            continue;
        }

        $packageFiles[] = (string) $fileInfo->getRealPath();
    }
}

sort($packageFiles);

$require = ['php' => $rootPhp];
$requireDev = [];
$replace = [];
$autoload = [];
$autoloadDev = [];
$excludeFromClassmap = [];

$packageNames = [];
foreach ($packageFiles as $file) {
    $json = json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
    $name = $json['name'] ?? null;
    if ($name === null) {
        fwrite(STDERR, "package missing name: {$file}\n");
        exit(1);
    }
    $packageNames[$name] = $file;
}

$conflicts = [];
$phpMismatches = [];
// dep => list of versions seen, by bucket, per package, for the cross-bucket pass.
$crossSeen = [];

foreach ($packageFiles as $file) {
    $json = json_decode((string) file_get_contents($file), true, flags: JSON_THROW_ON_ERROR);
    $name = $json['name'];
    $relativeDir = substr(dirname($file), strlen($root) + 1);
    $replace[$name] = 'self.version';

    foreach (['require', 'require-dev'] as $section) {
        foreach ($json[$section] ?? [] as $dep => $version) {
            if (isset($packageNames[$dep])) {
                continue;
            }

            if ($dep === 'php') {
                if ($version !== $rootPhp) {
                    $phpMismatches[] = "{$name}: {$version} (root: {$rootPhp})";
                }

                continue;
            }

            $crossSeen[$dep][$section][$name] = $version;

            $target = $section === 'require' ? 'require' : 'requireDev';
            $existing = $target === 'require' ? ($require[$dep] ?? null) : ($requireDev[$dep] ?? null);
            if ($existing !== null && $existing !== $version) {
                $conflicts[] = "{$dep}: {$existing} vs {$version} (in {$name})";
                continue;
            }
            if ($target === 'require') {
                $require[$dep] = $version;
            } else {
                $requireDev[$dep] = $version;
            }
        }
    }

    foreach ($json['autoload']['psr-4'] ?? [] as $ns => $path) {
        $autoload[$ns] = trim($relativeDir . '/' . $path, '/') . '/';
    }
    foreach ($json['autoload-dev']['psr-4'] ?? [] as $ns => $path) {
        $autoloadDev[$ns] = trim($relativeDir . '/' . $path, '/') . '/';
    }
    foreach ($json['autoload']['exclude-from-classmap'] ?? [] as $pattern) {
        $excludeFromClassmap[] = '/' . trim($relativeDir . $pattern, '/');
    }
}

// Cross-bucket reconciliation: when the same dep appears in `require` in one
// sub-package and `require-dev` in another, `require` wins at the root — a
// hard requirement always dominates a test-only one — and the merged root
// drops it from `require-dev`. Surface the demotion so the per-package
// files can be cleaned up.
$crossBucket = [];
foreach ($crossSeen as $dep => $buckets) {
    if (!isset($buckets['require'], $buckets['require-dev'])) {
        continue;
    }

    $requirePackages = implode(', ', array_keys($buckets['require']));
    $devPackages = implode(', ', array_keys($buckets['require-dev']));
    $crossBucket[] = "{$dep}: require in [{$requirePackages}], require-dev in [{$devPackages}] — promoted to require";

    unset($requireDev[$dep]);
}

$failures = [];

if ($conflicts !== []) {
    $failures[] = "version conflicts:\n  " . implode("\n  ", $conflicts);
}
if ($phpMismatches !== []) {
    $failures[] = "php constraint mismatches (must equal root):\n  " . implode("\n  ", $phpMismatches);
}

if ($failures !== []) {
    fwrite(STDERR, implode("\n", $failures) . "\n");
    exit(1);
}

if ($crossBucket !== []) {
    fwrite(STDERR, "cross-bucket overlaps reconciled (require wins):\n  " . implode("\n  ", $crossBucket) . "\n");
}

ksort($require);
ksort($requireDev);
ksort($replace);
ksort($autoload);
ksort($autoloadDev);

// Stamp the file as generated so a future hand-edit (e.g. a `composer
// require ...` that touches the root file) is visible at a glance.
$rootJson = ['_generated_by' => 'bin/merge — do not hand-edit. Edit src/SoureCode/**/composer.json instead and re-run the script.'] + $rootJson;

$rootJson['require'] = $require;
if ($requireDev !== []) {
    $rootJson['require-dev'] = $requireDev;
} else {
    unset($rootJson['require-dev']);
}
$rootJson['replace'] = $replace;
$rootJson['autoload'] = ['psr-4' => $autoload, 'exclude-from-classmap' => $excludeFromClassmap];
$rootJson['autoload-dev'] = ['psr-4' => $autoloadDev];

$serialized = json_encode($rootJson, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";

if ($checkOnly) {
    $existing = (string) file_get_contents($rootFile);

    if ($existing !== $serialized) {
        fwrite(STDERR, "composer.json is out of sync with sub-packages — run bin/merge.\n");
        exit(2);
    }

    printf("composer.json is in sync (%d package(s))\n", count($packageFiles));
    exit(0);
}

file_put_contents($rootFile, $serialized);

printf("merged %d package(s)\n", count($packageFiles));
foreach ($packageFiles as $file) {
    $rel = substr($file, strlen($root) + 1);
    printf("  - %s\n", $rel);
}
